# ===================================================
# Q-MolAI Environment Configuration
# ===================================================

# Application
PROJECT_NAME="Q-MolAI"
VERSION="1.0.0"

# Security & Secrets
# Generate a strong 256-bit random key in production: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# Local development default: SQLite
DATABASE_URL="sqlite:///./qmolai.db"
# PostgreSQL production string:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/qmolai"

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL (for Next.js client)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Storage
STORAGE_DIR="./storage"
DATASET_DIR="./storage/datasets"
ARTIFACTS_DIR="./storage/artifacts"

# Quantum Simulator Boundaries
MAX_SIMULATOR_QUBITS=12
DEFAULT_QUBITS=4
DEFAULT_CIRCUIT_DEPTH=2
